{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOMO-Canvas",
  "version": "0.6.1",
  "identifier": "site.jinpengi.momo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MOMO 智能画布",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPDATA\\**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../models/sr/4xNomosWebPhoto_esrgan_fp32_opset17.onnx": "models/4xNomosWebPhoto_esrgan_fp32_opset17.onnx",
      "../models/sr/4xNomosWebPhoto_RealPLKSR_fp32_opset17.onnx": "models/4xNomosWebPhoto_RealPLKSR_fp32_opset17.onnx",
      "../models/sr/4xNomosUni_span_multijpg_fp32_opset17.onnx": "models/4xNomosUni_span_multijpg_fp32_opset17.onnx",
      "../models/sr/1xDeJPG_realplksr_otf_60_fp32_opset17.onnx": "models/1xDeJPG_realplksr_otf_60_fp32_opset17.onnx",
      "../models/THIRD_PARTY_MODELS.txt": "models/THIRD_PARTY_MODELS.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExRUM3N0Y4ODM5QkMzOTEKUldTUnc1dUQrSGZzb1o5aFdna2o3Mndsb1NaTlNldHdiZVF1WVpMNzdXQjhzSlQ4ZUVIZ1RxcVEK",
      "endpoints": [
        "https://github.com/zhong5829/momo-canvas/releases/latest/download/latest.json"
      ]
    }
  }
}
