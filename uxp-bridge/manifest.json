{
  "id": "site.jinpengi.momo.bridge",
  "name": "MOMO Bridge",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PPRO",
    "minVersion": "22.0.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "read"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "momo.bridge.panel",
      "label": {
        "default": "MOMO Bridge"
      },
      "minimumSize": { "width": 280, "height": 400 },
      "preferredDockedSize": { "width": 320, "height": 500 }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
    }
  ]
}
